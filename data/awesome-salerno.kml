    <Folder>
      <name>Parchi (12)</name>
      <description>POI categoria Parchi</description>
      <Placemark id="parco-cilento">
        <name>Parco Nazionale del Cilento e Vallo di Diano</name>
        <description><![CDATA[Parco Nazionale UNESCO. 180.000 ettari di natura e archeologia. Paestum, Velia, grotte, borghi medievali.<br/>
Zona: Salerno | Città: Omignano | Tipo: archeologico<br/>
<a href="https://www.openstreetmap.org/?mlat=40.2833&amp;mlon=15.1667#map=16/40.2833/15.1667">Link</a>]]></description>
        <styleUrl>#style-parchi</styleUrl>
        <Point>
          <coordinates>15.1667,40.2833,0</coordinates>
        </Point>
      </Placemark>
      <Placemark id="parco-ferriere">
        <name>Parco Naturale delle Ferriere</name>
        <description><![CDATA[Parco naturale con cascate fino a 60m e sentieri. Valle dei Mulini e antiche cartiere.<br/>
Zona: Costiera | Città: Amalfi | Tipo: archeologico<br/>
<a href="https://www.openstreetmap.org/?mlat=40.6356&amp;mlon=14.6007#map=16/40.6356/14.6007">Link</a>]]></description>
        <styleUrl>#style-parchi</styleUrl>
        <Point>
          <coordinates>14.6007,40.6356,0</coordinates>
        </Point>
      </Placemark>
      <Placemark id="riserva-costiera">
        <name>Riserva Naturale Costiera Amalfitana</name>
        <description><![CDATA[Riserva marina e terrestre. Flora e fauna mediterranea. Area marina protetta.<br/>
Zona: Costiera | Città: Amalfi | Tipo: altro<br/>
<a href="https://www.openstreetmap.org/?mlat=40.6333&amp;mlon=14.6#map=16/40.6333/14.6">Link</a>]]></description>
        <styleUrl>#style-parchi</styleUrl>
        <Point>
          <coordinates>14.6,40.6333,0</coordinates>
        </Point>
      </Placemark>
      <Placemark id="area-marina-infreschi">
        <name>Area Marina Protetta Costa degli Infreschi e della Masseta</name>
        <description><![CDATA[Area marina protetta nel Cilento. Acque cristalline, grotte sommerse, praterie di posidonia.<br/>
Zona: Salerno | Città: San Giovanni a Piro | Tipo: spiaggia<br/>
<a href="https://www.openstreetmap.org/?mlat=40.033&amp;mlon=15.378#map=16/40.033/15.378">Link</a>]]></description>
        <styleUrl>#style-parchi</styleUrl>
        <Point>
          <coordinates>15.378,40.033,0</coordinates>
        </Point>
      </Placemark>
      <Placemark id="parchi-tenuta-castelluccio-gole-del-cervati">
        <name>Tenuta Castelluccio Gole del Cervati</name>
