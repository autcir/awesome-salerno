      </Placemark>
      <Placemark id="presepe-vivente">
        <name>Presepe Vivente</name>
        <description><![CDATA[Rappresentazione del presepe nel centro storico. Attori, artigiani, animali dal vivo.<br/>
Zona: Costiera | Città: Vietri sul Mare | Tipo: altro<br/>
<a href="https://www.comune.salerno.it">Link</a>]]></description>
