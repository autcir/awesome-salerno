{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autcir.github.io/awesome-salerno/schema/evento-scraped.schema.json",
  "title": "Evento raccolto dall'ingest (data/eventi_scraped.json)",
  "type": "object",
  "required": ["id", "nome", "link", "data_inizio", "data_fine", "tipo", "curated", "source", "license", "retrieved_at", "provenance"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "nome": {"type": "string", "minLength": 1},
    "link": {"type": "string", "pattern": "^https?://\\S+$"},
    "data_inizio": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "data_fine": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "tipo": {"type": "string"},
    "curated": {"const": false},
    "source": {
      "type": "object",
      "required": ["id", "name", "url", "type"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"},
        "url": {"type": "string"}, "type": {"type": "string"}
      }
    },
    "license": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "minLength": 10},
    "provenance": {"type": "string", "minLength": 1},
    "visto_prima_volta": {"type": "string"},
    "visto_ultima_volta": {"type": "string"},
    "ufficiale": {},
    "data_via": {}
  }
}
