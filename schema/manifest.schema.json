{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autcir.github.io/awesome-salerno/schema/manifest.schema.json",
  "title": "data/manifest.json",
  "type": "object",
  "required": ["schema_version", "generated_at", "counts", "licensing", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string"},
    "counts": {"type": "object"},
    "licensing": {"type": "object", "required": ["sources"]},
    "files": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["path", "bytes", "sha256"],
        "properties": {"path": {"type": "string"}, "bytes": {"type": "integer"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    }
  }
}
