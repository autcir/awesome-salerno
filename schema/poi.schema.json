{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autcir.github.io/awesome-salerno/schema/poi.schema.json",
  "title": "Voce (POI) di awesome-salerno",
  "description": "Voce dei file sentieri, monumenti, spiagge, panorami, parchi. Campi extra ammessi (additivi). I limiti GPS non stanno qui: li applica validate_data.py da schema/limits.json, fonte unica.",
  "type": "object",
  "required": ["id", "nome", "descrizione", "lat", "lng", "zona", "citta", "tipo", "source", "link"],
  "properties": {
    "id": {"type": "string", "pattern": "^\\S+$"},
    "nome": {"type": "string", "minLength": 1},
    "descrizione": {"type": "string"},
    "lat": {"type": "number"},
    "lng": {"type": "number"},
    "zona": {"enum": ["salerno", "costiera", "cilento"]},
    "citta": {"type": "string", "minLength": 1},
    "quartiere": {"type": "string"},
    "tipo": {"enum": ["altro", "archeologico", "castello", "chiesa", "festa-patronale", "festival", "fonte", "grotta", "luci-artista", "monumento", "museo", "panorama", "piazza", "ponte", "porta", "sagra", "scala", "sentiero", "spiaggia", "torre"]},
    "source": {"enum": ["osm", "hand-written", "curated", "web"]},
    "link": {"type": "string", "pattern": "^https?://\\S+$"},
    "link_rotto": {"type": "string", "pattern": "^https?://\\S+$"},
    "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "last_checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "last_status": {"type": "string", "minLength": 1},
    "link_type": {"enum": ["external", "osm_generated"]},
    "link_rotto_checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "link_rotto_status": {"type": "string", "minLength": 1},
    "provincia": {"type": "string", "minLength": 1},
    "sigla_provincia": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "regione": {"type": "string", "minLength": 1},
    "in_ambito": {"type": "boolean"},
    "osm_id": {"type": "integer"},
    "osm_type": {"enum": ["node", "way", "relation"]},
    "difficolta": {"type": "string"},
    "dislivello_m": {"type": ["number", "null"]},
    "lunghezza_km": {"type": ["number", "null"]},
    "periodo": {"type": "string"},
    "frequenza": {"type": "string"},
    "artista": {"type": "string"},
    "data_inizio": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "data_fine": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "edizione": {"type": ["string", "integer", "null"]},
    "anno_inizio": {"type": ["integer", "null"]},
    "ricorrenza": {"enum": ["annuale", "biennale", "una_tantum"]},
    "luoghi": {"type": "array", "items": {"type": "string"}}
  }
}
